' =============================================================================
' dac.bas - DAC initialisation
' =============================================================================

' =============================================================================
' INIT_DAC
' Enables the DAC output on the MO6 sound chip.
' =============================================================================
PROC init_dac
    ON CPU6809 BEGIN ASM
        LDA   $A7CF
        ANDA  #$FB
        STA   $A7CF
        LDB   #$3F
        STB   $A7CD
        ORA   #$04
        STA   $A7CF
    END ASM ON CPU6809
END PROC
